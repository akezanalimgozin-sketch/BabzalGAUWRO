@HoldDKp = 2.0

Function LargeBase()
  @kB = 1
  @kC = 1
  LineFollower4.SetMotorSigns(@kB, @kC)
EndFunction

Function MiddleBase()
  @kB = -1
  @kC = 1
  LineFollower4.SetMotorSigns(@kB, @kC)
EndFunction

Function Check()
  If @kB = 0 Or @kC = 0 Then
    Speaker.Note(100, "C5", 500)
    LCD.Clear()
    LCD.Write(10, 10, "ERROR: Base not set!")
    Program.End()
  EndIf
EndFunction

Function Stop()
  Motor.Stop("BC", "True")
EndFunction

Function InitLine4(in number sensorMode, in number s1Black, in number s1White, in number s2Black, in number s2White, in number s3Black, in number s3White, in number s4Black, in number s4White)
  LineFollower4.Config(sensorMode)
  LineFollower4.ConfigSensorBW(1, s1Black, s1White)
  LineFollower4.ConfigSensorBW(2, s2Black, s2White)
  LineFollower4.ConfigSensorBW(3, s3Black, s3White)
  LineFollower4.ConfigSensorBW(4, s4Black, s4White)
  LineFollower4.SetCenterPair(4, 2)
  LineFollower4.SetLeftPair(2, 3)
  LineFollower4.SetRightPair(1, 4)
  LineFollower4.SetWeights(-150, -50, 50, 150)
  LineFollower4.SetThreshold(@LineThreshold)
  LineFollower4.SetMarkThreshold(@MarkThreshold)
  LineFollower4.SetILimit(200)
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
EndFunction

Function InitLine4BW(in number sensorMode, in number s1Black, in number s1White, in number s2Black, in number s2White, in number s3Black, in number s3White, in number s4Black, in number s4White)
  InitLine4(sensorMode, s1Black, s1White, s2Black, s2White, s3Black, s3White, s4Black, s4White)
EndFunction

Function InitLine4RGBW(in number s1BlackR, in number s1BlackG, in number s1BlackB, in number s1WhiteR, in number s1WhiteG, in number s1WhiteB, in number s2BlackR, in number s2BlackG, in number s2BlackB, in number s2WhiteR, in number s2WhiteG, in number s2WhiteB, in number s3BlackR, in number s3BlackG, in number s3BlackB, in number s3WhiteR, in number s3WhiteG, in number s3WhiteB, in number s4BlackR, in number s4BlackG, in number s4BlackB, in number s4WhiteR, in number s4WhiteG, in number s4WhiteB)
  LineFollower4.ConfigRGBW()
  LineFollower4.ConfigSensorRGBW(1, s1BlackR, s1BlackG, s1BlackB, s1WhiteR, s1WhiteG, s1WhiteB)
  LineFollower4.ConfigSensorRGBW(2, s2BlackR, s2BlackG, s2BlackB, s2WhiteR, s2WhiteG, s2WhiteB)
  LineFollower4.ConfigSensorRGBW(3, s3BlackR, s3BlackG, s3BlackB, s3WhiteR, s3WhiteG, s3WhiteB)
  LineFollower4.ConfigSensorRGBW(4, s4BlackR, s4BlackG, s4BlackB, s4WhiteR, s4WhiteG, s4WhiteB)
  LineFollower4.SetCenterPair(4, 2)
  LineFollower4.SetLeftPair(2, 3)
  LineFollower4.SetRightPair(1, 4)
  LineFollower4.SetWeights(-150, -50, 50, 150)
  LineFollower4.SetThreshold(@LineThreshold)
  LineFollower4.SetMarkThreshold(@MarkThreshold)
  LineFollower4.SetILimit(200)
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
EndFunction

