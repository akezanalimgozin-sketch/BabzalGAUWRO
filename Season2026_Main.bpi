Function FollowLineStep()
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
EndFunction

Function FollowLineMs(in number runtimeMs)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  start = Time.Get1()
  exit = 0
  
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    
    If Time.Get1() - start >= runtimeMs Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Function FollowLineUntilCross(in number minActive)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  exit = 0
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    LineFollower4.getActiveCount(active)
    
    If active >= minActive Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Function SoloL(in number spd,in number DestEnc)
  Motor.Stop("BC", "true")
  StartB = MotorB.GetTacho()
  exit=0
   While exit=0
    MotorB.StartPower((spd) * @kB)
    encB = MotorB.GetTacho() - StartB
    avg = Math.Abs(encB) 
    If avg >= DestEnc Then
      exit = 1
    EndIf
    
  EndWhile
  
EndFunction

  

Function SoloR(in number spd,in number DestEnc)
    Motor.Stop("BC", "true")

   StartC = MotorC.GetTacho()
  exit=0
   While exit=0
        MotorC.StartPower((spd) * @kC)

    encC = MotorC.GetTacho() - StartC
    avg = Math.Abs(encC)
    If avg >= DestEnc Then
      exit = 1
    EndIf
    
  EndWhile
  

EndFunction

Function FollowLineUntilLost(in number lostLoops)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  lostCounter = 0
  exit = 0
  
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    
    If found = "False" Then
      lostCounter = lostCounter + 1
    Else
      lostCounter = 0
    EndIf
    
    If lostCounter >= lostLoops Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Function CenterOnLine(in number holdMs)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  start = Time.Get1()
  exit = 0
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, 0, @LineKp, @LineKi, @LineKd, turn, position, found)
    
    If Time.Get1() - start >= holdMs Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Function FollowUntilGLeft()
  FollowUntilGLeftCount(1)
EndFunction

Function FollowUntilGRight()
  FollowUntilGRightCount(1)
EndFunction

Function FollowUntilTLine()
