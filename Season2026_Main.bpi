EndFunction
speed = 50
DestEnc = 180
curr_speed = 30
@avgs=0
@integral=0
kp_line = 0.5
kd_line = 5
ki_line = 0.01
@prevEnc = 0
@prevTime = 0
OldE = 0
s1exists = "true"
s2exists = "true"
s3exists = "true"
s4exists = "true"

Function SmoothSpeed()
  max_speed = @speed
  If @curr_speed < max_speed Then
    If @prevTime = 0 Then
      @prevTime = Time.Get2()
    EndIf
    If @prevEnc = 0 Then
      encB = MotorB.GetTacho()
      encC = MotorC.GetTacho()
      @prevEnc = (Math.Abs(encB) + Math.Abs(encC))/2
    EndIf
    delta_time = Time.Get2() - @prevTime
    If delta_time > 10 Then
      encB = MotorB.GetTacho()
      encC = MotorC.GetTacho()
      enc = (Math.Abs(encB) + Math.Abs(encC))/2
      delta_enc = enc - @prevEnc
      If delta_enc > @DestEnc Then
        delta_enc = @DestEnc
      EndIf
      delta_speed = delta_enc * max_speed / @DestEnc
      If delta_speed < 1 Then
        delta_speed = 1 ' избавляемся от замкнутого круга приращений нуля
      EndIf
      @curr_speed += delta_speed
      ' Заполняем предыдущие значения
      @prevTime = Time.Get2()
      @prevEnc = enc
    EndIf
  Else
    @curr_speed = max_speed
  EndIf
EndFunction

function reg()
  If @s2exists = "true" Then
    @s2 = Sensor.ReadPercent(4)
  Else
    @s2 = @avgS
  EndIf
  If @s4exists = "true" Then
    @s4 = Sensor.ReadPercent(2)
  Else
    @s4 = @avgS
  EndIf
  E = @s2 - @s4
  P = E * @kp_line
  I = @integral + (E * @ki_line)
  D = (E - @OldE) * @kd_line
  A = P + I + D
  @OldE = E
  integral = I
  SmoothSpeed()
 
  MotorB.StartPower((@curr_speed + A) * @kB)
  MotorC.StartPower((@curr_speed - A) * @kC)
EndFunction


Function LineX()
  Check()
  @OldE = 0
  exit = 0
  While exit = 0
    reg()
    ' остановка на Х-перекрёстке: оба датчика видят маленькое значения яркости
    If @s2 < 15 And @s4 < 15 Then
      exit = 1
    EndIf
  EndWhile
EndFunction

Function FollowUntilTCount(in number targetCount)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  hitCount = 0
  confirmCounter = 0
  wasOn = 0
  exit = 0
  
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    LineFollower4.isTLine(markNow)
    
    If markNow = "True" Then
      confirmCounter = confirmCounter + 1
      If confirmCounter >= @LineMarkConfirmLoops Then
        If wasOn = 0 Then
          hitCount = hitCount + 1
          wasOn = 1
        EndIf
      EndIf
    Else
      confirmCounter = 0
      wasOn = 0
    EndIf
    
    If hitCount >= targetCount Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Sub _HoldASub
  @HoldARunning = 1
  While @HoldAEnabled = 1
    Error = @HoldATarget - Motor.GetCount("A")
    Power = Error * @HoldAKp
    
    If Power > 50 Then
      Power = 50
    ElseIf Power < -50 Then
      Power = -50
    EndIf
    
    Motor.StartPower("A", Power)
    Program.Delay(10)
  EndWhile
  @HoldARunning = 0
EndSub

Function nazad(in number power, in number DestEnc)
    Check() ' Проверка конфигурации базы

    ' --- Инициализация для этого конкретного движения ---
    StartB = MotorB.GetTacho()          ' Начальное положение B
    StartC = MotorC.GetTacho()          ' Начальное положение C
    @OldE = 0                           ' Сброс предыдущей ОШИБКИ ВЫРАВНИВАНИЯ
    ' Базовая мощность для движения назад (делаем отрицательной)
    baseBackwardPower = Math.Abs(power) * -1

    ' Используем While "True" и Break для цикла
    While "True"
        ' --- Расчет пройденного пути каждым мотором ---
        encB = MotorB.GetTacho() - StartB
        encC = MotorC.GetTacho() - StartC

        ' --- ПД-регулятор ВЫРАВНИВАНИЯ ---
        ' Расчет ошибки выравнивания (так же, как для vpered)
        E = encC * @kC - encB * @kB
        ' Расчет P и D компонент (ИСПОЛЬЗУЕМ _align коэффициенты!)
        P = E * @kp_align
        D = (E - @OldE) * @kd_align
        ' Расчет корректирующего воздействия
        A = P + D
        ' Обновление предыдущей ошибки для следующей итерации
        @OldE = E

        ' --- Применение мощности к моторам для движения НАЗАД ---
        ' Базовая ОТРИЦАТЕЛЬНАЯ мощность +/- коррекция (A)
        powerB = baseBackwardPower + A
        powerC = baseBackwardPower - A
        ' Ограничение мощности [-100, 100]
        powerB = Math.Min(100, Math.Max(-100, powerB))
        powerC = Math.Min(100, Math.Max(-100, powerC))
        ' Установка мощности
        MotorB.StartPower(powerB * @kB)
        MotorC.StartPower(powerC * @kC)

        ' --- Расчет среднего пройденного расстояния (по модулю) ---
        avg = (Math.Abs(encB) + Math.Abs(encC))/2

        ' --- Проверка условия выхода ---
        If avg >= DestEnc Then ' Используем >= для надежности остановки
          Break ' Выход из цикла While
        EndIf

        ' --- Thread.Yield() НЕ ДОБАВЛЕН (по вашей инструкции) ---

    EndWhile ' Конец цикла While

    ' --- Stop() НЕ ДОБАВЛЕН (по вашей инструкции) ---
    ' !!! ПОМНИТЕ: Моторы продолжат вращаться с последней заданной мощностью !!!
    ' !!! Вы должны вызвать Stop() в основном коде СРАЗУ после вызова nazad !!!

EndFunction


Sub _HoldDSub
  @HoldDRunning = 1
  While @HoldDEnabled = 1
    Error = @HoldDTarget - Motor.GetCount("D")
    Power = Error * @HoldDKp
    
    If Power > 100 Then
      Power = 100
    ElseIf Power < -100 Then
      Power = -100
    EndIf
    
    Motor.StartPower("D", Power)
    Program.Delay(10)
  EndWhile
  @HoldDRunning = 0
EndSub

Function ReadLinePort(in number port, out number value)
  LineFollower4.getNormByPort(port, value)
EndFunction

Function FollowUntilGLeftNear()
  FollowUntilGLeftByPortCount(1, 2)
EndFunction

Function FollowUntilGRightNear()
  FollowUntilGRightByPortCount(1, 4)
EndFunction

Function FollowUntilGLeftByPortCount(in number targetCount, in number confirmPort)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  hitCount = 0
  confirmCounter = 0
  wasOn = 0
  exit = 0
  
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    LineFollower4.isGLeft(markNow)
    LineFollower4.getNormByPort(confirmPort, confirmValue)
    
    If markNow = "True" And confirmValue >= @SeenBlackMin And confirmValue <= @SeenBlackMax Then
      confirmCounter = confirmCounter + 1
      If confirmCounter >= @LineMarkConfirmLoops Then
        If wasOn = 0 Then
          hitCount = hitCount + 1
          wasOn = 1
        EndIf
      EndIf
    Else
      confirmCounter = 0
      wasOn = 0
    EndIf
    
    If hitCount >= targetCount Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction

Function FollowUntilGRightByPortCount(in number targetCount, in number confirmPort)
  Check()
  LineFollower4.SetMotorSigns(@kB, @kC)
  LineFollower4.ResetPID()
  
  hitCount = 0
  confirmCounter = 0
  wasOn = 0
  exit = 0
  
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    
    LineFollower4.FollowPIDPair(@LinePairMode, @LineBasePower, @LineKp, @LineKi, @LineKd, turn, position, found)
    LineFollower4.isGRight(markNow)
    LineFollower4.getNormByPort(confirmPort, confirmValue)
    
    If markNow = "True" And confirmValue >= @SeenBlackMin And confirmValue <= @SeenBlackMax Then
      confirmCounter = confirmCounter + 1
      If confirmCounter >= @LineMarkConfirmLoops Then
        If wasOn = 0 Then
          hitCount = hitCount + 1
          wasOn = 1
        EndIf
      EndIf
    Else
      confirmCounter = 0
      wasOn = 0
    EndIf
    
    If hitCount >= targetCount Then
      exit = 1
    EndIf
    
    Program.Delay(10)
  EndWhile
  Stop()
EndFunction


Function ReleaseMotorPID(in string Port)
  If Port = "A" Then
    @HoldAEnabled = 0
    If @HoldARunning = 1 Then
      Program.Delay(20)
    EndIf
  ElseIf Port = "D" Then
    @HoldDEnabled = 0
    If @HoldDRunning = 1 Then
      Program.Delay(20)
    EndIf
  EndIf
EndFunction

Function MotorHoldPIDTarget(in string Port, in number TargetDeg, in number kp_hold)
  If Port = "A" Then
    @HoldATarget = TargetDeg
    @HoldAKp = kp_hold
    @HoldAEnabled = 1
    If @HoldARunning = 0 Then
      Thread.Run = _HoldASub
    EndIf
  ElseIf Port = "D" Then
    @HoldDTarget = TargetDeg
    @HoldDKp = kp_hold
    @HoldDEnabled = 1
    If @HoldDRunning = 0 Then
      Thread.Run = _HoldDSub
    EndIf
  EndIf
EndFunction

Function MotorHoldPID(in string Port)
  If Port = "A" Then
    MotorHoldPIDTarget("A", Motor.GetCount("A"), 2.0)
  ElseIf Port = "D" Then
    MotorHoldPIDTarget("D", Motor.GetCount("D"), 2.0)
  EndIf
EndFunction

Function MotorPower(in string Port, in number Power)
  ReleaseMotorPID(Port)
  Motor.StartPower(Port, Power)
EndFunction

Function StopMotor(in string Port, in string brake)
  ReleaseMotorPID(Port)
  Motor.Stop(Port, brake)
EndFunction

Function RunMotorSmart(in string Port, in number Power, in number LimitDeg)
  ReleaseMotorPID(Port)
  Motor.ResetCount(Port)
  Motor.StartPower(Port, Power)
  Program.Delay(150)
  StallCounter = 0
  exit = 0
  While exit = 0
    If @StopSignal = 1 Then
       exit = 1
    EndIf
    CurrentDeg = Math.Abs(Motor.GetCount(Port))
    If CurrentDeg >= LimitDeg Then
       exit = 1
    EndIf
    CurrentSpeed = Math.Abs(Motor.GetSpeed(Port))
    If CurrentSpeed < 70 Then
       StallCounter = StallCounter + 1
    Else
       StallCounter = 0
    EndIf
    If StallCounter > 60 Then
       exit = 1
    EndIf
    Program.Delay(20)
  EndWhile
  Motor.Stop(Port, "True")
EndFunction

Sub _AsyncMotorSub
  RunMotorSmart(@AsyncPort, @AsyncSpeed, @AsyncDeg)
EndSub

Function RunMotorAsync(in string Port, in number Power, in number LimitDeg)
  @AsyncPort = Port
  @AsyncSpeed = Power
  @AsyncDeg = LimitDeg
  Thread.Run = _AsyncMotorSub
EndFunction

Function MoveSmart(in number DistDeg, in number Spd)
  Check()
  Motor.ResetCount("BC")
  Dir = 1
  If DistDeg < 0 Then
    Dir = -1
  EndIf
  Target = Math.Abs(DistDeg)
  StallCounter = 0
  Motor.StartPower("B", Spd * Dir * @kB)
  Motor.StartPower("C", Spd * Dir * @kC)
  Program.Delay(150)
  exit = 0
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    EncB = Math.Abs(Motor.GetCount("B"))
    EncC = Math.Abs(Motor.GetCount("C"))
    Avg = (EncB + EncC) / 2
    Error = EncB - EncC
    Correction = Error * @kp_sync
    PowB = (Spd - Correction) * Dir * @kB
    PowC = (Spd + Correction) * Dir * @kC
    Motor.StartPower("B", PowB)
    Motor.StartPower("C", PowC)
    If Avg >= Target Then
      exit = 1
    EndIf
    SpdB = Math.Abs(Motor.GetSpeed("B"))
    SpdC = Math.Abs(Motor.GetSpeed("C"))
    If (SpdB + SpdC) / 2 < 5 Then
      StallCounter = StallCounter + 1
    Else
      StallCounter = 0
    EndIf
    If StallCounter > 10 Then
      exit = 1
    EndIf
    Program.Delay(10)
  EndWhile
  Motor.Stop("BC", "True")
EndFunction

Function TurnSmart(in number Angle, in number Spd)
  Check()
  Motor.ResetCount("BC")
  TargetMotorDeg = Math.Abs(Angle * @TurnRatio)
  Dir = 1
  If Angle < 0 Then
    Dir = -1
  EndIf
  StallCounter = 0
  Motor.StartPower("B", Spd * Dir * @kB)
  NegSpd = 0 - Spd
  Motor.StartPower("C", NegSpd * Dir * @kC)
  Program.Delay(150)
  exit = 0
  While exit = 0
    If @StopSignal = 1 Then
      exit = 1
    EndIf
    EncB = Math.Abs(Motor.GetCount("B"))
    EncC = Math.Abs(Motor.GetCount("C"))
    Avg = (EncB + EncC) / 2
    Error = EncB - EncC
    Correction = Error * @kp_sync
    PowB = (Spd - Correction) * Dir * @kB
    NegVal = 0 - (Spd + Correction)
    PowC = NegVal * Dir * @kC
    Motor.StartPower("B", PowB)
    Motor.StartPower("C", PowC)
    If Avg >= TargetMotorDeg Then
      exit = 1
    EndIf
    SpdB = Math.Abs(Motor.GetSpeed("B"))
    SpdC = Math.Abs(Motor.GetSpeed("C"))
    If (SpdB + SpdC) / 2 < 5 Then
      StallCounter = StallCounter + 1
    Else
      StallCounter = 0
    EndIf
    If StallCounter > 10 Then
      exit = 1
    EndIf
    Program.Delay(10)
  EndWhile
  Motor.Stop("BC", "True")
EndFunction
