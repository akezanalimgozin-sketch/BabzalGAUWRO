@LineKp = 0.55
@LineKi = 0.02
@LineKd = 1.20
@LineThreshold = 50
@MarkThreshold = 70
@LineCrossActive = 3
@LinePairMode = 0
@LineMarkConfirmLoops = 3
@SeenBlackMin = 85
@SeenBlackMax = 100

@StopSignal = 0
@AsyncPort = "A"
@AsyncSpeed = 0
@AsyncDeg = 0

@HoldAEnabled = 0
@HoldDEnabled = 0
